{
  "name": "baoanlight",
  "version": "2.0.23",
  "description": "A little tracked robot that floats on your Windows desktop and shows what every AI coding agent is doing — Claude Code, Codex, DeepSeek Harness, WorkBuddy and anything else that can report.",
  "author": {
    "name": "baoan778",
    "url": "https://github.com/baoan778"
  },
  "bin": {
    "baoanlight": "src/cli.js",
    "bao": "src/cli.js"
  },
  "main": "src/cli.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/cli.js start",
    "overlay": "electron src/overlay/main.js",
    "server": "node src/cli.js server",
    "setup": "node scripts/setup.js",
    "build:pages": "node scripts/build-pages.mjs",
    "shot:hero": "node scripts/hero-shot.js",
    "vendor:three": "node scripts/vendor-three.js",
    "status": "node src/cli.js status",
    "agents": "node src/cli.js agents",
    "test": "node --test",
    "test:electron": "node test-electron/overlay-smoke.js",
    "check:pack": "node scripts/check-pack.js",
    "lint": "eslint .",
    "doctor": "node src/cli.js doctor",
    "watch:codex": "node src/cli.js watch codex",
    "test:ui": "playwright test",
    "test:all": "npm test && npm run test:ui"
  },
  "engines": {
    "node": ">=20"
  },
  "os": [
    "win32"
  ],
  "license": "MIT",
  "optionalDependencies": {
    "electron": "^38.0.0",
    "node-pty": "^1.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baoan778/baoanlight.git"
  },
  "homepage": "https://baoan778.github.io/baoanlight",
  "keywords": [
    "claude-code",
    "codex",
    "deepseek",
    "workbuddy",
    "ai-agent",
    "overlay",
    "desktop-robot",
    "windows",
    "status",
    "always-on-top",
    "gemini-cli",
    "aider",
    "developer-tools",
    "cli"
  ],
  "files": [
    "src",
    "scripts",
    "docs/index.html",
    "docs/*.md",
    "docs/robot.png",
    "docs/demo",
    "README.md",
    "CHANGELOG.md",
    "CODE_OF_CONDUCT.md",
    "THIRD_PARTY_NOTICES.md",
    "DEPLOY.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "bugs": {
    "url": "https://github.com/baoan778/baoanlight/issues"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "three": "^0.187.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  }
}
